# ==========================================
# SoundStream - Environment Variables
# ==========================================

# AWS Cloud Integration (Amazon S3)
# To store uploaded songs and album art in your AWS S3 bucket, provide credentials below.
# If left empty, SoundStream seamlessly operates in "Demo / Mock Cloud Mode" with persistent local storage!
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# Optional: If you use CloudFront CDN in front of S3
NEXT_PUBLIC_AWS_CLOUDFRONT_DOMAIN=

# Optional: Next.js App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
